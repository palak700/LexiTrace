LEXITRACE_MODE=demo
# Export variables in your shell; this file is a reference, not auto-loaded.
# DATABASE_URL=postgresql+psycopg://lexitrace:YOUR_PASSWORD@localhost:5432/lexitrace
# LEXITRACE_DOCUMENT_MODEL=/absolute/path/to/ml/models/document
# LEXITRACE_SENTENCE_MODEL=/absolute/path/to/ml/models/sentence

# Admin signup is disabled until a secret setup code is exported in the shell.
# LEXITRACE_ADMIN_SIGNUP_CODE=choose-a-long-random-secret
# Set true when serving the application over HTTPS.
# LEXITRACE_COOKIE_SECURE=true
# Optional: persistent local account/session database path (default: backend/accounts.sqlite3)
# LEXITRACE_AUTH_DB=/absolute/path/to/accounts.sqlite3
# Character limit used by both the API and dashboard (spaces included).
# LEXITRACE_MAX_TEXT_CHARS=20000

