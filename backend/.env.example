LEXITRACE_MODE=model
# Use the existing three-class document checkpoint; model weights stay out of Git.
LEXITRACE_DOCUMENT_MODEL=../ml/models/document
LEXITRACE_BACKEND_PORT=8000
LEXITRACE_MAX_TEXT_CHARS=20000
# SRS was not supplied: keep login required until the access policy is confirmed.
LEXITRACE_ALLOW_ANONYMOUS=false
# Optional document classifier scores on sentence fragments.
# Captum token attribution is available separately on demand through /api/explain.
LEXITRACE_SENTENCE_EVIDENCE=false
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/lexitrace
# LEXITRACE_ADMIN_SIGNUP_CODE=set-a-private-random-code-in-your-environment
# LEXITRACE_COOKIE_SECURE=true
# LEXITRACE_AUTH_DB=./accounts.sqlite3
# LEXITRACE_EVALUATION_DATA=../ml/data/processed/document
# LEXITRACE_RESEARCH_DIR=../ml/research-reports
